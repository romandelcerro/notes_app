{
  "name": "@notes-app/frontend",
  "version": "22.0.0",
  "scripts": {
    "ng": "ng",
    "set-env": "node --env-file=.env scripts/set-env.mjs",
    "set-env:ci": "node scripts/set-env.mjs",
    "start": "ng serve",
    "build": "pnpm set-env:ci && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint \"src/**/*.{ts,html}\"",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.4",
    "@angular/cdk": "^22.0.2",
    "@angular/common": "^22.0.4",
    "@angular/compiler": "^22.0.4",
    "@angular/core": "^22.0.4",
    "@angular/forms": "^22.0.4",
    "@angular/material": "^22.0.2",
    "@angular/platform-browser": "^22.0.4",
    "@angular/router": "^22.0.4",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@notes-app/shared": "workspace:*",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-architects/native-federation": "^22.0.2",
    "@angular/build": "^22.0.4",
    "@angular/cli": "^22.0.4",
    "@angular/compiler-cli": "^22.0.4",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.0.0",
    "eslint": "^10.6.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  }
}
